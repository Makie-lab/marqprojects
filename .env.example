# ─────────────────────────────────────────────────────────────
# Public site origin (used for canonical URLs, sitemap, OG tags)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://marqprojects.vercel.app

# ─────────────────────────────────────────────────────────────
# Transactional email (Resend) — OPTIONAL
# When unset, contact + asset requests fall back to a pre-filled
# Gmail compose hand-off. The site stays fully functional.
# Get a key: https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be a sender on a domain you've verified in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Inbox that receives contact messages and visual-asset requests.
CONTACT_TO_EMAIL=mebsamson04@gmail.com

# ─────────────────────────────────────────────────────────────
# Visual-asset request integrations (Gmail + Canva)
# Gmail uses CONTACT_TO_EMAIL above. Canva links are public URLs.
# ─────────────────────────────────────────────────────────────
# Default Canva destination when a project has no specific design link.
NEXT_PUBLIC_CANVA_PROFILE_URL=https://www.canva.com/
NEXT_PUBLIC_CANVA_URL=https://www.canva.com/design/

# ─────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────
# Set to "debug" for verbose structured logs.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Reserved for future integrations (currently unused)
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
